# Copy to .env and adjust as needed. Every value here is read via
# pydantic-settings somewhere in the codebase — keep this file in sync.

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO
TZ=UTC

# --- Ingestion ---
INGEST_MODE=simulate            # simulate | opensky
# Which airport pool / OpenSky bounding box to use: europe | us | india | all.
# India is the target-audience default; Europe and US remain fully selectable.
REGION=india
POLL_INTERVAL_SECONDS=15
# Optional manual bbox override — leave all four commented out to let REGION
# pick the bounding box (see ingestion/config.py:REGION_BBOXES). Only takes
# effect if ALL FOUR are uncommented and set.
# BBOX_LAMIN=45
# BBOX_LOMIN=5
# BBOX_LAMAX=56
# BBOX_LOMAX=20
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_ANON_POLL_INTERVAL_SECONDS=60
SIMULATOR_AIRCRAFT_COUNT=150
SIMULATOR_ANOMALY_RATE=0.02

# --- Redpanda / Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_FLIGHTS_RAW=flights.raw
KAFKA_TOPIC_FLIGHTS_DLQ=flights.raw.dlq

# --- Storage (MinIO / S3) ---
STORAGE_BACKEND=minio            # minio | s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=liveflights
AWS_REGION=us-east-1
AWS_S3_BUCKET=liveflights-archive

# --- Postgres ---
# NOTE: host port is 5433, not the Postgres default 5432 — this machine
# already runs a separate native/Homebrew Postgres on 5432 (unrelated to
# this project), so the container is remapped to avoid the collision.
# Container-to-container traffic (mlflow, etc.) still uses 5432 internally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=liveflights
POSTGRES_USER=liveflights
POSTGRES_PASSWORD=liveflights
DATABASE_URL=postgresql://liveflights:liveflights@localhost:5433/liveflights

# --- Streaming (Spark bronze/silver/gold jobs) ---
# SPARK_CORES bounds each job to local[N] rather than local[*] — several
# Spark drivers (bronze, silver, gold, later Airflow tasks) run concurrently
# on this machine, and local[*] per-driver caused a multi-minute scheduling
# stall in P3 when they all grabbed every core at once.
SPARK_CORES=2
SHUFFLE_PARTITIONS=8
DRIVER_MEMORY=2g
EXECUTOR_MEMORY=2g
CHECKPOINT_ROOT=./data/checkpoints

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=60

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_ARTIFACT_ROOT=s3://liveflights/mlflow
MLFLOW_ANOMALY_MODEL_NAME=flight-anomaly-detector
MLFLOW_FORECAST_MODEL_NAME=traffic-forecaster

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
WS_PUSH_INTERVAL_SECONDS=3

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/flights

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
