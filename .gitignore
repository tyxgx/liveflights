# Recommended .gitignore contents for liveflights.
# Per project rules, this repo does not create .gitignore automatically —
# copy the block below into .gitignore yourself.

# --- Secrets / env ---
.env
*.pem
*.key
~/.aws/

# --- Python ---
__pycache__/
*.pyc
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# --- Node / Next.js ---
web/node_modules/
web/.next/
web/out/
web/.env.local
.pnpm-store/

# --- Data / lake / warehouse (local dev artifacts) ---
data/
*.parquet
delta-lake/
minio-data/
warehouse/
spark-warehouse/
metastore_db/
derby.log

# --- dbt ---
transform/target/
transform/dbt_packages/
transform/logs/

# --- Airflow ---
orchestration/logs/
orchestration/airflow.db
orchestration/airflow-webserver.pid

# --- MLflow ---
mlruns/
mlartifacts/

# --- Terraform ---
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl

# --- Docker / OS ---
.DS_Store
*.log

# --- IDE ---
.vscode/
.idea/

# Terraform plan files — build artifacts, can contain unredacted sensitive vars
infra/terraform/*.tfplan
infra/terraform/tfplan.out

# Local-only ML scratch artifacts (regenerable model binaries/plots/test outputs) -
# the scripts that produce them are committed, the outputs aren't.
ml/scratch/artifacts/
ml/scratch/artifacts_prev_*/
ml/scratch/__pycache__/
web/tsconfig.tsbuildinfo

# Trained model checkpoints (.pt/.onnx/norm.json per run) - regenerable from
# ml/scratch/train_gru_v2.py + ml/scratch/export_onnx.py, not source.
runs/

# Terminal run logs from run_logs/run.sh (the "he runs commands, I read the logs"
# workflow) - the runner script itself is real source and stays tracked, its
# generated output (dated .log files + the INDEX/LATEST pointer files) isn't.
run_logs/*.log
run_logs/INDEX.txt
run_logs/LATEST.txt
