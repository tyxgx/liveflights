# Production build config for the static export deployed to S3
# (infra/terraform's site bucket — see docs/aws-architecture.md).
# `next build` loads this automatically for production builds; no manual
# env vars needed at build time. These are NEXT_PUBLIC_* (inlined into the
# client bundle at build time, not read at runtime) so none of this is
# secret — safe to commit.

# Cloud API Gateway endpoint (infra/terraform's api_endpoint output)
NEXT_PUBLIC_API_BASE_URL=https://m9o2yg64dj.execute-api.us-east-1.amazonaws.com

# Empty on purpose: the cloud API has no WebSocket (Lambda invocations are
# stateless/short-lived, can't hold one open — see docs/aws-architecture.md).
# CLOUD_MODE in app/page.tsx is derived from `!WS_URL`, so leaving this
# empty is what switches the dashboard to polling GET /api/flights/live
# instead of trying to open a WebSocket that doesn't exist here.
NEXT_PUBLIC_WS_URL=

# Region config was switched from India to Europe (multi-point adsb.lol
# coverage) — see docs/aws-architecture.md for why.
NEXT_PUBLIC_DEFAULT_REGION=europe
